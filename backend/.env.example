# MSME Sahayak AI - Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Google Sheets Database Configuration
# Option 1: Path to service account credentials JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Option 2: Full JSON string of service account key (useful for cloud deployments like Render/Railway/Heroku)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Google Sheet Identification
# The ID from the Google Sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Or the exact title of the spreadsheet (if created automatically or in Google Drive)
GOOGLE_SHEET_NAME=MSME_Sahayak_Database

# Security
SECRET_KEY=sih-msme-sahayak-super-secret-key-2026
CORS_ORIGINS=["*"]
